# Optional: if omitted on first start, a strong access key is generated in data/initial-password.txt
APP_PASSWORD=change-this-to-a-long-random-key

# The server listens on all interfaces so it can sit behind a tunnel or reverse proxy.
HOST=0.0.0.0
PORT=8787

# Use COOKIE_SECURE=1 when HTTPS is terminated by your proxy/tunnel.
COOKIE_SECURE=0
MAX_FILE_BYTES=262144000
